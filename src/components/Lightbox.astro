<div id="image-lightbox" popover="auto" aria-label="Expanded image">
  <img id="image-lightbox-img" alt="" />
</div>

<style>
  #image-lightbox {
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
    margin: auto;
  }

  #image-lightbox::backdrop {
    background: rgb(0 0 0 / 75%);
  }

  #image-lightbox img {
    display: block;
    width: auto;
    height: auto;
    max-width: calc(100vw - 2rem);
    max-height: calc(100vh - 2rem);
    object-fit: contain;
    box-shadow: 0 1rem 3rem rgb(0 0 0 / 50%);
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 768px) {
    :global(post-card img[data-lightboxable='true']) {
      cursor: zoom-in;
    }
  }
</style>

<script is:inline src="/lightbox.js"></script>
